EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_LEGACY_ANON_KEY

# RevenueCat — public SDK keys, injected only via the EAS build profile
# environment, never committed with a real value.
#   Production (preview + production profiles):
# EXPO_PUBLIC_REVENUECAT_PURCHASES_ENABLED=true
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
#   Test Store QA build ONLY — opt-in. Set these on a dedicated QA profile;
#   the production profile must NEVER set EXPO_PUBLIC_REVENUECAT_TEST_STORE_ENABLED.
# EXPO_PUBLIC_REVENUECAT_TEST_STORE_ENABLED=true
# EXPO_PUBLIC_REVENUECAT_TEST_STORE_API_KEY=

# Prompt 3 QA commands read these only from the invoking terminal environment.
# Never commit a real QA password.
# QA_TEST_EMAIL=
# QA_TEST_PASSWORD=
# QA_SEED_CONFIRM=ARACIM_CEPTE_QA
# QA_REMOTE_CONFIRM=ARACIM_CEPTE_REMOTE_QA
# QA_SEND_RESET=false
