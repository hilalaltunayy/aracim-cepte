{
  "expo": {
    "name": "Aracım Cepte",
    "slug": "aracim-cepte",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "aracimcepte",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.hilalaltunay.aracimcepte",
      "supportsTablet": false
    },
    "android": {
      "package": "com.hilalaltunay.aracimcepte",
      "versionCode": 2,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#2FAFEA",
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2FAFEA",
          "defaultChannel": "reminders"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Aracım Cepte, ekspertiz belgesi fotoğrafı çekebilmeniz için kamerayı kullanır.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EAF8FB",
          "image": "./assets/images/adaptive-foreground.png",
          "imageWidth": 88,
          "dark": {
            "backgroundColor": "#0B151B",
            "image": "./assets/images/adaptive-foreground.png"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6caa53cd-710f-4651-9c0a-2eca48fe64c3"
      }
    },
    "owner": "hilalaltunay"
  }
}
